# Generated model outputs
artifacts/*.csv
artifacts/*.json

# LaTeX build products - track only the reviewed final manuscript PDF.
paper/build/*
# Keep the directory visible even if a user-level gitignore excludes build/.
!paper/build/
!paper/build/CRM_revised.pdf
paper/*.aux
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.pdf
paper/*.synctex.gz
paper/*.xdv

# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
dist/
build/
*.egg-info/

# Lean / Lake local dependency and compiler artifacts
formal/lean/.lake/
formal/lean/*.olean
formal/lean/*.ilean
formal/lean/*.c

# Private prospective CRPI study data and approvals must never be committed.
# These patterns are an accidental-commit safeguard, not a substitute for access controls.
/data/private/
/data/field_private/
/study_private/
/artifacts/pilot_private/
